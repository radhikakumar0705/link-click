{
  "manifest_version": 3,
  "name": "link-click — URL Shortener",
  "short_name": "link-click",
  "version": "1.0.0",
  "description": "Shorten the page you're on or any link in one click. Copied to your clipboard instantly, with click analytics.",
  "minimum_chrome_version": "116",

  "permissions": [
    "activeTab",
    "alarms",
    "clipboardWrite",
    "contextMenus",
    "notifications",
    "offscreen",
    "storage"
  ],

  "action": {
    "default_popup": "popup/index.html",
    "default_title": "Shorten this page",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+L" },
      "description": "Open link-click"
    }
  },

  "background": {
    "service_worker": "background/service_worker.js",
    "type": "module"
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
